{
  "name": "watch-discovery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual watch-taste discovery: one real photo at a time, Yay / Nay / Pass.",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run catalogue:validate",
    "catalogue:validate": "tsx scripts/catalogue/validate.ts",
    "catalogue:find": "tsx scripts/catalogue/find-candidates.ts",
    "catalogue:accept": "tsx scripts/catalogue/accept.ts",
    "catalogue:add-own": "tsx scripts/catalogue/add-own-photo.ts",
    "photos:fetch": "tsx scripts/photos/fetch.ts",
    "photos:accept": "tsx scripts/photos/accept.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "undici": "^8.11.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
